# Copiar a .env.qa (ignorado por Git). NUNCA commitear valores reales.
QA_ENV=qa
QA_BASE_URL=https://<ambiente>
QA_API_URL=https://<ambiente>/api/v1
# Ruta de login de la app (relativa a QA_BASE_URL)
QA_LOGIN_PATH=/app/ingresar
# Una cuenta dedicada por rol (nombres en mayúsculas: OWNER, ADMIN, DOCTOR, ASSISTANT, ODONTOLOGO, RECEPCION...)
QA_USER_OWNER_EMAIL=
QA_USER_OWNER_PASSWORD=
QA_USER_DOCTOR_EMAIL=
QA_USER_DOCTOR_PASSWORD=
# Opcional
QA_TOKEN=
QA_DB_URL_RO=
# Jira (camino REST)
JIRA_BASE_URL=https://<sitio>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
